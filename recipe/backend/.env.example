# Copy to .env and adjust. All values have dev-friendly defaults except secrets.

# --- Database ---
# Postgres in production, e.g. postgresql+psycopg2://user:pass@localhost:5432/recipes
# Defaults to a local SQLite file for zero-config local dev.
DATABASE_URL=sqlite:///./recipes.db

# --- Auth ---
# CHANGE THIS in any non-local environment.
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Anthropic (LLM recipe parsing) ---
ANTHROPIC_API_KEY=
# Configurable; defaults to current Sonnet.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Redis (optional) ---
# When set, the parse rate limiter is enforced GLOBALLY across all workers and
# instances. Leave blank for a per-process in-memory limiter (fine for local dev).
# e.g. redis://localhost:6379/0  or  rediss://:password@host:6379/0
REDIS_URL=

# --- Parse endpoint limits ---
PARSE_RATE_LIMIT_PER_HOUR=20
MAX_TEXT_LENGTH=20000
FETCH_TIMEOUT_SECONDS=5
MAX_FETCH_BYTES=2097152
MAX_REDIRECTS=3

# --- CORS (comma-separated origins; * for all in dev) ---
CORS_ORIGINS=*
